    {
      "name": "08 GET productos por categoria (solo disponibles)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/productos?categoriaId={{categoriaId}}&soloDisponibles=true",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "productos"
          ],
          "query": [
            {
              "key": "categoriaId",
              "value": "{{categoriaId}}"
            },
            {
              "key": "soloDisponibles",
              "value": "true"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Incluye el producto creado', () => pm.expect(pm.response.json().length).to.be.above(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 GET producto por id",
      "request": {
        "method": "GET",
        "header": [],
