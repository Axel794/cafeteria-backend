      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('Informa el detalle del error', () => pm.expect(pm.response.json().detalles.length).to.be.above(0));"
            ]
          }
        }
      ]
