      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 409', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 POST producto (crear)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "productos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"nombre\": \"Latte de prueba\", \"descripcion\": \"Espresso con leche\", \"precio\": 13.00, \"categoriaId\": {{categoriaId}}, \"alergenos\": \"Lactosa\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test('Disponible por defecto', () => pm.expect(j.disponible).to.eql(true));",
              "pm.collectionVariables.set('productoId', j.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 POST producto con precio 0 (400)",
      "request": {
        "method": "POST",
        "header": [
