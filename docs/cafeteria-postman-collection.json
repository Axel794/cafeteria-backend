    {
      "name": "11 POST pedido LOCAL (crear)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/pedidos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "pedidos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"tipoPedido\": \"LOCAL\", \"numeroMesa\": 5, \"detalles\": [{\"productoId\": {{productoId}}, \"cantidad\": 2, \"notas\": \"sin azucar\"}]}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test('Estado inicial PENDIENTE', () => pm.expect(j.estado).to.eql('PENDIENTE'));",
              "pm.test('Total = 2 x 13.00', () => pm.expect(Number(j.total)).to.eql(26));",
              "pm.test('Tiene ticket unico CDD-', () => pm.expect(j.codigoTicket).to.match(/^CDD-/));",
              "pm.collectionVariables.set('pedidoId', j.id);"
            ]
          }
        }
      ]
    },
