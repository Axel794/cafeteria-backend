# Copiar a ".env" y cambiar los valores. NO subir ".env" a GitHub.
DB_USER=cafeteria
DB_PASSWORD=cambiar-esta-clave
# Minimo 32 caracteres, aleatoria. Ejemplo para generarla en PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_SECRET=cambiar-por-una-clave-larga-y-aleatoria-de-48-caracteres
SEED_ADMIN_PASSWORD=cambiar-clave-admin
SEED_BARISTA_PASSWORD=cambiar-clave-barista
# true solo para mostrar Swagger en una demo
SWAGGER_ENABLED=false
